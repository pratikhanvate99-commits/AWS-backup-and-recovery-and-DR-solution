        SNS["Amazon SNS<br/>Notifications<br/>(Confirm)"]
        LMB["AWS Lambda<br/>Automation<br/>(Proposed)"]
    end

    subgraph REC["Recovery Environment"]
        RS3[("Recovery Storage<br/>Cross-Region Copy<br/>(Proposed)")]
